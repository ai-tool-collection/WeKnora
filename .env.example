# #####################################################################
# #####################################################################

#
#
#
# SEARXNG_PORT=8888
# Do not set SEARXNG_PORT to the same value as APP_PORT (default 8080).
# On Linux, binding SearXNG to 127.0.0.1:8080 while the app also publishes
# :8080 makes localhost:8080 hit SearXNG first — POST /api/v1/auth/login
# then returns SearXNG's HTML 404 even though DISABLE_REGISTRATION only
# closes registration (see discussion on issue #3296). Keep SearXNG on 8888
# (or another free port).
# SEARXNG_BIND=127.0.0.1
# SEARXNG_SECRET=
# TAVILY_API_KEY=tvly-your_tavily_api_key

# WEKNORA_API_KEY=
# MCP_SERVER_AUTH_TOKEN=
# WEKNORA_CHAT_TIMEOUT=300
# WEKNORA_VERIFY_SSL=true
# MCP_ALLOWED_UPLOAD_DIRS=


