WEKNORA_VERSION=latest
APK_MIRROR_ARG=
# WITH_ANYDOC=1
# APT_MIRROR=
# VITE_FRONTEND_COMMIT=
# NPM_REGISTRY=
# NODE_MAX_OLD_SPACE_SIZE=4096

GIN_MODE=release
# LOG_LEVEL=debug
# LOG_PATH=
# LOG_FORMAT=
# LLM_DEBUG_LOG=true
TZ=UTC
# WEKNORA_LANGUAGE=en-US
# DEFAULT_LOCALE=en-US
# VITE_DEFAULT_LOCALE=en-US
AUTO_MIGRATE=true
AUTO_RECOVER_DIRTY=true
# WEKNORA_BOOTSTRAP_SYSTEM_ADMIN_EMAIL=

APP_HOST=app
APP_PORT=8080
# APP_BACKEND_PORT=8080
# APP_SCHEME=http
FRONTEND_PORT=80
DOCREADER_ADDR=docreader:50051
DOCREADER_TRANSPORT=grpc
# APP_EXTERNAL_URL=
# FRONTEND_BASE_URL=
# RESOURCE_URL_MODE=handle
# MCP_PORT=8082


# #####################################################################
# #####################################################################

DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123!@#
DB_NAME=Knowledge Hub
# DB_PATH=./data/weknora.db

STREAM_MANAGER_TYPE=redis
REDIS_ADDR=redis:6379
# REDIS_USERNAME=
REDIS_PASSWORD=redis123!@#
REDIS_DB=0
REDIS_PREFIX=stream:
# WEKNORA_REDIS_NAMESPACE=
# WEKNORA_REDIS_OP_TIMEOUT_MS=500

# REDIS_USE_TLS=false
# REDIS_TLS_SERVER_NAME=
# REDIS_TLS_INSECURE_SKIP_VERIFY=false

# WEKNORA_ASYNQ_CORE_CONCURRENCY=8
